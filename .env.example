# ── Agent Office — environment ──────────────────────────────────────────────
# Copy to `.env` (git-ignored) and fill in your own key. Nothing here is
# required: without a key the office runs in demo mode with scripted workers.

# OpenAI-compatible gateway. Any endpoint that speaks /v1/chat/completions works.
OFFICE_ENDPOINT=https://ai.sinarcloud.com/v1

# Your key. Never committed — the server keeps it in memory only.
OFFICE_API_KEY=sk-replace-me

# Model used by the workers. The free tier model is the default and is also
# the automatic fallback when the selected model runs out of credit.
OFFICE_MODEL=deepseek/deepseek-v4-1-flash

# Set to 1 to let agents use the sandboxed file/shell tools at boot.
OFFICE_TOOLS=0

# Port for the API server (serves the built client too).
OFFICE_PORT=8787

# Origin allowed to call the API during development.
OFFICE_CLIENT_ORIGIN=http://127.0.0.1:5173

# Sandbox root for agent file and command access, relative to the repo root.
OFFICE_WORKSPACE=workspace
