{
  "name": "agent-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D virtual office where AI agents work as visible workers",
  "bin": {
    "aegisxworker": "bin/aegisxworker.mjs"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "worker": "node bin/aegisxworker.mjs",
    "dev:client": "npm -w client run dev",
    "dev:server": "npm -w server run dev",
    "build": "npm -w client run build",
    "typecheck": "npm -w client run typecheck && npm -w server run typecheck",
    "check:usage": "node --experimental-strip-types scripts/usage-check.mjs",
    "check:gate": "node --experimental-strip-types scripts/gate-check.mjs",
    "check:memory": "node --experimental-strip-types scripts/memory-check.mjs",
    "check:snapshot": "node --experimental-strip-types scripts/snapshot-check.mjs",
    "check:restore": "node --experimental-strip-types scripts/restore-check.mjs",
    "eval": "node --experimental-strip-types scripts/eval.mjs",
    "check:eval": "node --experimental-strip-types scripts/eval-check.mjs",
    "check:i18n": "node --experimental-strip-types scripts/i18n-check.mjs",
    "check:wording": "node --experimental-strip-types scripts/wording-check.mjs",
    "check:language": "node --experimental-strip-types scripts/language-check.mjs",
    "check:cleanup": "node --experimental-strip-types scripts/cleanup-check.mjs",
    "check": "npm run typecheck && npm run check:gate && npm run check:memory && npm run check:snapshot && npm run check:usage && npm run check:restore && npm run check:eval && npm run check:i18n && npm run check:wording && npm run check:language && npm run check:cleanup && npm run check:http && npm run check:shell && npm run check:failure && npm run check:toolkit && npm run check:router && npm run check:review && npm run check:concurrency && npm run check:args && npm run check:vision && npm run check:merge && npm run check:worktree && npm run check:docs && npm run check:outputs && npm run check:jail && npm run check:prompt && npm run check:playbook",
    "start": "npm -w server run start",
    "check:i18n:browser": "node --experimental-strip-types scripts/browser-i18n-check.mjs",
    "check:http": "node --experimental-strip-types scripts/http-check.mjs",
    "check:shell": "node --experimental-strip-types scripts/shell-check.mjs",
    "check:failure": "node --experimental-strip-types scripts/failure-check.mjs",
    "check:toolkit": "node --experimental-strip-types scripts/toolkit-check.mjs",
    "check:router": "node --experimental-strip-types scripts/router-check.mjs",
    "check:review": "node --experimental-strip-types scripts/review-check.mjs",
    "check:jail": "node --experimental-strip-types scripts/jail-check.mjs",
    "failure:export": "node --experimental-strip-types scripts/export-failure.mjs",
    "check:prompt": "node --experimental-strip-types scripts/prompt-check.mjs",
    "check:concurrency": "node --experimental-strip-types scripts/concurrency-check.mjs",
    "check:args": "node --experimental-strip-types scripts/arg-check.mjs",
    "check:vision": "node --experimental-strip-types scripts/vision-check.mjs",
    "check:merge": "node --experimental-strip-types scripts/merge-check.mjs",
    "check:outputs": "node --experimental-strip-types scripts/output-check.mjs",
    "check:worktree": "node --experimental-strip-types scripts/worktree-check.mjs",
    "check:docs": "node --experimental-strip-types scripts/docs-check.mjs",
    "check:playbook": "node --experimental-strip-types scripts/playbook-check.mjs",
    "eval:playbook": "node --experimental-strip-types scripts/eval-playbook.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
